# SmartPatch Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Server settings (optional — defaults shown)
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
DEBUG=false

# ---------------------------------------------------------------------------
# Dataset / project settings
# ---------------------------------------------------------------------------
# Root directory containing one sub-folder per project
DATA_DIR=datasets

# Comma-separated list of project keys to load at startup
PROJECTS=onap

# ---------------------------------------------------------------------------
# Retrieval settings (optional)
# ---------------------------------------------------------------------------
DEFAULT_TOP_K=5
DEFAULT_WINDOW_DAYS=14
# Strategy: multi_query | hybrid | file_boost
RETRIEVAL_STRATEGY=multi_query

# ---------------------------------------------------------------------------
# LLM API keys (only needed for scripts/llm_rerank.py)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

